# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). Na Vercel, cadastre as mesmas variáveis em
# Settings → Environment Variables.

# Públicas (podem aparecer no navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable

# SECRETA — nunca compartilhe e nunca coloque no GitHub
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service_role-ou-secret
